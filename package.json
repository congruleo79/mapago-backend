{
  "name": "mapago-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "ai:events": "node scripts/ai/events.mjs",
    "ai:events:fetch": "node --experimental-strip-types scripts/events.ts",
    "ai:candidates:get": "node scripts/ai/get-candidates.mjs",
    "ai:select-and-seed": "node scripts/ai/select-and-seed.mjs",
    "seed:locations": "node --experimental-strip-types scripts/seed-locations.ts",
    "ratings:backfill": "node --experimental-strip-types scripts/backfill-ratings.ts",
    "ai:blacklist": "node scripts/ai/blacklist.mjs",
    "ai:validate": "node scripts/ai/validate.mjs",
    "ai:validate:locations": "node scripts/ai/validate-locations.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "wrangler": "^4.26.0"
  }
}
